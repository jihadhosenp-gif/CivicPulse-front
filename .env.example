# Backend API base URL
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# App display name
NEXT_PUBLIC_APP_NAME=CivicPulse AI

# Map picker (report submission)
# The interactive map uses Leaflet + OpenStreetMap tiles loaded from a public CDN
# and requires NO API key. These vars are optional and only used if you later
# switch to a keyed provider (e.g. Mapbox) in components/report/map-picker.tsx.
# NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
# NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors